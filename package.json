{
  "name": "agile-m2b",
  "version": "0.0.0",
  "private": true,
  "description": "Team M2B: a web app that gives incoming exchange students at unibz an ordered overview of their first weeks in Bolzano.",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:steps",
    "start": "ng serve",
    "prebuild": "npm run build:steps",
    "build": "ng build",
    "prewatch": "npm run build:steps",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build:steps",
    "test": "ng test",
    "check:content": "node scripts/check-content.mjs",
    "build:steps": "node scripts/build-steps.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@ng-icons/core": "^33.4.0",
    "@ng-icons/lucide": "^33.4.0",
    "@spartan-ng/brain": "1.10.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.0",
    "cn": "^0.5.2",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "ajv": "^8.20.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
