{
  "name": "agile-m2b",
  "version": "0.0.0",
  "private": true,
  "description": "Team M2B: a web app that gives incoming exchange students at unibz an ordered overview of their first weeks in Bolzano.",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "npm run check:content",
    "start": "ng serve",
    "prebuild": "npm run check:content",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:content": "node scripts/check-content.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "ajv": "^8.20.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
